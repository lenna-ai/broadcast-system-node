# Application
NODE_ENV=production
PORT=3000
JSON_BODY_LIMIT=1mb
APP_TIMEZONE=Asia/Jakarta
SCHEDULER_CRON=* * * * *

# RabbitMQ
RABBITMQ_URL=amqp://user:password@host:5672/vhost

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# WhatsApp channel ID in omnichannel.integrations
WHATSAPP_CHANNEL_ID=4

# Knex connection pool (per PM2 process)
# Total DB connections ≈ (queue + adira + failed + server + scheduler) × DB_POOL_MAX
# Example: (2 + 2 + 1 + 2) × 5 = 35 connections
# See docs/SERVER_SPECS.md for capacity planning (10k–100k blast)
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_CREATE_TIMEOUT=30000
DB_POOL_REAP_INTERVAL=1000
DB_MAX_CONNECTIONS_BUDGET=40

# RabbitMQ consumer prefetch (must be <= DB_POOL_MAX per process)
RABBITMQ_PREFETCH=5
RABBITMQ_FAILED_PREFETCH=3

# Worker throttle between successful sends (ms), 0 to disable
BROADCAST_THROTTLE_MS=50
BROADCAST_ADIRA_THROTTLE_MS=50
BROADCAST_AVG_API_MS=200

# PM2 cluster instances
PM2_QUEUE_INSTANCES=2
PM2_ADIRA_QUEUE_INSTANCES=2
PM2_FAILED_QUEUE_INSTANCES=1

# Scheduler — safe for 10k–100k recipients
SCHEDULER_CHUNK_SIZE=25
MAX_QUEUE_BATCH_SIZE=25
SCHEDULER_RECIPIENT_PAGE_SIZE=1000
SCHEDULER_PUBLISH_DELAY_MS=10

# Dev/staging only — disable in production
ENABLE_STRESS_ENDPOINT=false

# Monitor worker (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
